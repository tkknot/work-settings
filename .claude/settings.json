{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "language": "japanese",
  "advisorModel": "opus",
  "enableWorkflows": true,
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-code-plugins": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/wezterm-tab-status.sh\" idle"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/wezterm-tab-status.sh\" run"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/wezterm-tab-status.sh\" wait"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/wezterm-tab-status.sh\" run"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/wezterm-tab-status.sh\" done"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/wezterm-tab-status.sh\" idle"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); if command -v jq >/dev/null 2>&1; then model=$(printf '%s' \"$input\" | jq -r '.model.display_name'); effort=$(printf '%s' \"$input\" | jq -r '.effort.level // empty'); else model=$(printf '%s' \"$input\" | grep -o '\"display_name\":\"[^\"]*\"' | head -1 | cut -d'\"' -f4); effort=\"\"; fi; if [ -n \"$effort\" ]; then printf '%s | effort: %s\\n' \"$model\" \"$effort\"; else printf '%s\\n' \"$model\"; fi"
  }
}
